public class Person {
    public static void main(String[] args) {
        Person p1 = new Person("Kofi", 21);
        Person p2 = new Person("Ama", 25);

        p1.display();
        p2.display();

    }
    String name;
    int age;

    Person(String name, int age){
        this.name = name;
        this.age = age;
    }
     void display(){
        System.out.println("Name is "+name+" and age is "+age);
    }
}
